# Copy this file to .env and fill in your keys.
# NEVER commit .env — it is listed in .gitignore.

# Required for every phase
ANTHROPIC_API_KEY=sk-ant-...

# Required for RAG / embeddings — used by BOTH Finance Phase 4 and Retail Phase 5
# (both index with OpenAI text-embedding-3-small)
OPENAI_API_KEY=sk-proj-...

# Optional: only needed if you switch Retail embeddings back to Voyage (voyage-3)
# VOYAGE_API_KEY=pa-...

# Optional: override the default model
# ANTHROPIC_MODEL=claude-sonnet-4-6
